# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- CV import (all optional) ----
# Any provider with a key is tried in AI_PROVIDERS order; if none are set or all fail,
# the free rule-based parser is used. Nothing is called unless its key is set.
# AI_PROVIDERS=groq,gemini,openrouter,anthropic
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- GitHub README import (optional) ----
# Raises GitHub's limit from 60 to 5,000 requests/hour. A token with no scopes is enough.
# GITHUB_TOKEN=
